{
  "name": "restaurant-management-system",
  "version": "1.0.0",
  "description": "A complete restaurant management system with admin panel, kitchen panel, and QR code menu",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd backend && npm start",
    "client": "cd frontend && npm start",
    "install-all": "cd backend && npm install && cd ../frontend && npm install"
  },
  "keywords": ["restaurant", "management", "qr-code", "ordering"],
  "author": "TiagoMSantos2025",
  "license": "MIT",
  "engines": {
    "node": ">=14.0.0"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "qrcode": "^1.5.3",
    "sqlite3": "^5.1.6",
    "sequelize": "^6.28.0"
  },
  "devDependencies": {
    "concurrently": "^7.6.0"
  }
}